* {
    text-shadow: none;
    box-shadow: none;

    border: none;
    border-radius: 0;

    padding: 0;
    margin: 0;

    font-family: Ubuntu, sans-serif;
    font-weight: 600;
    font-size: 14px;

    transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
}

window#waybar {
    background: transparent;
    color: #f8f8f2;
}

/* https://colorhunt.co/palette/09232812544f2a835f8bbb92 */

.module,
tooltip {
    background: rgb(9, 35, 40);
    border: 2px rgb(18, 84, 79) solid;
}

button:hover,
widget:hover {
    background: rgb(42, 131, 95);
}

#taskbar button.active {
    background: rgb(18, 84, 79);
}

label.module,
#user > label {
    padding: 0 8px;
}

button {
    padding: 0 5px;
}

tooltip,
.module {
    border-radius: {{ .wm.outerBorderRadius }}px;
}

#custom-os_button {
    padding: 0 5px;
}

#custom-os_button:hover {
    margin: 0 2px;
    background: none;
    border: none;
}

#tray image {
    padding: 0 5px;
}

.module button:first-child,
#tray *:first-child {
    border-top-left-radius: {{ .wm.innerBorderRadius }}px;
    border-bottom-left-radius: {{ .wm.innerBorderRadius }}px;
}

.module button:last-child,
#tray *:last-child {
    border-top-right-radius: {{ .wm.innerBorderRadius }}px;
    border-bottom-right-radius: {{ .wm.innerBorderRadius }}px;
}

#temperature.critical {
    color: #dd7700;
}
