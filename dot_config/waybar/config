{
    "layer": "top",
    "position": "bottom",
    "mod": "dock",
    "exclusive": true,
    "gtk-layer-shell": true,
    "margin-bottom": -1,
    "passthrough": false,
    "height": 41,
    "spacing": 16,
    "modules-left": [
        "wlr/taskbar"
    ],
    "modules-center": [],
    "modules-right": [
        "pulseaudio",
        "temperature",
        "clock",
        "tray"
    ],
    "wlr/taskbar": {
        "all-outputs": true,
        "format": "{icon}",
        "icon-size": 21,
        "tooltip-format": "{title}",
        "on-click": "minimize-raise",
        "on-click-middle": "close"
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10,
        "show-passive-items": true
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M:%S}",
        "format-alt": "{:%Y-%m-%d}",
        "interval": 1
    },
    "temperature": {
        "interval": 3,
        "thermal-zone": 1,
        "warning-threshold": 50,
        "critical-threshold": 65,
        "format": "{temperatureC}°C 🌡️",
        "format-warning": "{temperatureC}°C ♨️",
        "format-critical": "{temperatureC}°C 🔥"
    },
    "pulseaudio": {
        "on-click": "pavucontrol",
        "scroll-step": 2,
        "format": "{volume}% {icon}",
        "format-muted": "🔇",
        "format-icons": {
            "default": [
                "🔈",
                "🔉",
                "🔊"
            ]
        }
    }
}
