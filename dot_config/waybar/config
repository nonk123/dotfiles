{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "gtk-layer-shell": true,
    "passthrough": false,
    "height": 32,
    "spacing": 8,
    "modules-left": [
        "mango/workspaces",
        "mango/layout"
    ],
    "modules-center": [
        "wlr/taskbar"
    ],
    "modules-right": [
        "mango/language",
        "pulseaudio",
        "temperature",
        "clock",
        "user",
        "tray"
    ],
    "mango/layout": {},
    "mango/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-click-right": "toggle"
    },
    "wlr/taskbar": {
        "all-outputs": true,
        "format": "{icon}",
        "icon-size": 20,
        "tooltip-format": "{title}",
        "on-click": "minimize-raise",
        "on-click-middle": "close"
    },
    "mango/language": {
        "format-en": "EN",
        "format-ru": "RU"
    },
    "tray": {
        "icon-size": 20,
        "show-passive-items": true
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M:%S}",
        "format-alt": "{:%Y-%m-%d}",
        "interval": 1
    },
    "temperature": {
        "interval": 3,
        "thermal-zone": 1,
        "warning-threshold": 50,
        "critical-threshold": 65,
        "format": "{temperatureC}°C 🌡️",
        "format-warning": "{temperatureC}°C ♨️",
        "format-critical": "{temperatureC}°C 🔥"
    },
    "pulseaudio": {
        "on-click": "pavucontrol",
        "scroll-step": 2,
        "format": "{volume}% {icon}",
        "format-muted": "🔇",
        "format-icons": {
            "default": [
                "🔈",
                "🔉",
                "🔊"
            ]
        }
    },
    "user": {
        "format": "up {work_d}d {work_H}:{work_M}"
    }
}
