{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "passthrough": false,
    "height": 28,
    "spacing": 6,
    "margin": "4 4 0 4",
    "modules-left": [
        "custom/os_button",
        "mango/workspaces",
        "mango/layout"
    ],
    "modules-center": [
        "wlr/taskbar"
    ],
    "modules-right": [
        "mango/language",
        "pulseaudio",
        "temperature",
        "clock",
        "user",
        "tray"
    ],
    "mango/layout": {},
    "mango/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-click-right": "toggle"
    },
    "wlr/taskbar": {
        "all-outputs": true,
        "format": "{icon}",
        "icon-size": 20,
        "tooltip-format": "{title}",
        "on-click": "minimize-raise",
        "on-click-middle": "close"
    },
    "mango/language": {
        "format-en": "EN",
        "format-ru": "RU"
    },
    "tray": {
        "icon-size": 20,
        "show-passive-items": true
    },
    "clock": {
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format": "{:%a 🕔 %H:%M:%S}",
        "format-alt": "{:%a 📅 %d.%m.%Y}",
        "interval": 1
    },
    "temperature": {
        "interval": 3,
        "thermal-zone": 1,
        "warning-threshold": 50,
        "critical-threshold": 65,
        "format": "{temperatureC}°C 🌡️",
        "format-warning": "{temperatureC}°C ♨️",
        "format-critical": "{temperatureC}°C 🔥"
    },
    "pulseaudio": {
        "on-click": "pavucontrol",
        "scroll-step": 2,
        "format": "{volume}% {icon}",
        "format-muted": "🔇",
        "format-icons": {
            "default": [
                "🔈",
                "🔉",
                "🔊"
            ]
        }
    },
    "user": {
        "format": "⏳ {work_d}d {work_H}:{work_M}"
    },
    "custom/os_button": {
        "tooltip": false,
        "image-path": "{{ .chezmoi.homeDir }}/.config/waybar/icon.png",
        "menu": "on-click",
        "menu-file": "{{ .chezmoi.homeDir }}/.config/waybar/menu.xml",
        "menu-actions": {
            "apply": "chezmoi apply",
            "reload-waybar-config": "chezmoi apply; pkill -SIGUSR2 waybar",
            "restart-mangowm": "mmsg dispatch quit"
        }
    }
}
